# Copy to .env.local (and add the same names in Vercel → Settings → Environment Variables).
# Everything below is optional for running the app: heatmaps work without any of it.
# Clerk → API keys, only for signing in to the admin page. The publishable key is public; the secret key is not.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_…
CLERK_SECRET_KEY=sk_test_…
# Neon → Connect, for analytics. Pooled for the app, direct (no -pooler) for migrations. Secret.
DATABASE_URL=postgresql://…-pooler…/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://…/neondb?sslmode=require
# Optional, recommended in production: any GitHub token (classic or fine-grained, no scopes needed).
# Contribution data then comes from GitHub's official API (5,000 points an hour), with the public
# scraper as backup. Without it only the public scraper is used. Secret.
GITHUB_TOKEN=
# Admin page (/admin.html): Google accounts allowed to see the analytics, comma-separated.
ADMIN_EMAILS=you@example.com
# Secret mixed into the daily anonymous visitor id. Set a long random value in production. Secret.
ANALYTICS_SALT=
