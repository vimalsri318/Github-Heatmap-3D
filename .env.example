# Copy to .env.local (and add the same names in Vercel → Settings → Environment Variables).
# Clerk → API keys. The publishable key is public; the secret key is not (server only).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_…
CLERK_SECRET_KEY=sk_test_…
# Neon → Connect. Pooled for the app, direct (no -pooler) for migrations. Secret.
DATABASE_URL=postgresql://…-pooler…/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://…/neondb?sslmode=require
# Optional, recommended in production: any GitHub token (classic or fine-grained, no scopes needed).
# Contribution data then comes from GitHub's official API (5,000 points an hour), with the public
# scraper as backup. Without it only the public scraper is used. Secret.
GITHUB_TOKEN=
